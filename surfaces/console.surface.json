{
  "schema": 2,
  "kind": "surface",
  "id": "console",
  "displayName": "Agent Console",
  "executor": "console",
  "state": {
    "document": "surface:console",
    "revisioned": false,
    "shape": {
      "type": "object",
      "properties": {
        "screen": { "type": "string" }
      }
    }
  },
  "commands": {
    "type": {
      "displayName": "Type into console",
      "exposedToAgent": true,
      "requiresHuman": false,
      "mutatesState": true,
      "reversible": false,
      "dryRun": true,
      "validWhen": "always",
      "input": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
          "text": { "type": "string", "maxLength": 4096 },
          "submit": { "type": "string", "enum": ["true", "false"] }
        },
        "required": ["id", "text"],
        "additionalProperties": false
      },
      "policy": {
        "defaultDecision": "Allow",
        "reason": "A principal may type into its own console session; each keystroke batch is audited, and isolation bounds the blast radius to that session's home."
      }
    }
  }
}
