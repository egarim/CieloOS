<!--
  CieloOS portal — Home. The "horizon" design in WinUI/Uno XAML.

  The sky is a Grid row painted with a LinearGradientBrush whose stops are swapped
  by VisualStateManager as the agent's state changes. The ground is a normal
  scrolling list on the app's surface brush. Nothing here needs a custom renderer.
-->
<Page
    x:Class="Cielo.Portal.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utu="using:Uno.Toolkit.UI"
    xmlns:m="using:Cielo.Portal.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.Resources>
    <!-- The three skies. One brush swap is the entire state change. -->
    <LinearGradientBrush x:Key="SkyWorking" StartPoint="0.5,0" EndPoint="0.5,1">
      <GradientStop Color="#16294A" Offset="0.0"/>
      <GradientStop Color="#2F5C93" Offset="0.46"/>
      <GradientStop Color="#6F9AC9" Offset="0.78"/>
      <GradientStop Color="#A8C4E2" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SkyNeedsYou" StartPoint="0.5,0" EndPoint="0.5,1">
      <GradientStop Color="#3A2536" Offset="0.0"/>
      <GradientStop Color="#8C5334" Offset="0.48"/>
      <GradientStop Color="#C3854C" Offset="0.78"/>
      <GradientStop Color="#E3B583" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SkyClear" StartPoint="0.5,0" EndPoint="0.5,1">
      <GradientStop Color="#3E6EA3" Offset="0.0"/>
      <GradientStop Color="#79A5D2" Offset="0.45"/>
      <GradientStop Color="#B7D2EA" Offset="0.80"/>
      <GradientStop Color="#DDE9F5" Offset="1.0"/>
    </LinearGradientBrush>

    <Style x:Key="EyebrowText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CharacterSpacing" Value="180"/>
      <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <!-- One card, reused. DataTemplate keeps the ground list trivial. -->
    <DataTemplate x:Key="WorkCardTemplate" x:DataType="m:WorkItem">
      <Border Margin="0,0,0,10"
              Padding="14,13"
              CornerRadius="16"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderThickness="1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid ColumnSpacing="11">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                  Background="{x:Bind KindBrush}">
            <TextBlock Text="{x:Bind Kind}" FontSize="10" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <!-- TextTrimming, not wrapping: a long file name must not reflow the row. -->
            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
            <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.65"
                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
          </StackPanel>

          <Border Grid.Column="2" Visibility="{x:Bind MadeByAgentVisibility}"
                  CornerRadius="20" Padding="8,3"
                  Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
            <TextBlock Text="Made for you" FontSize="11" FontWeight="SemiBold"
                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- sky    -->
      <RowDefinition Height="*"/>      <!-- ground -->
      <RowDefinition Height="Auto"/>   <!-- tabs   -->
    </Grid.RowDefinitions>

    <!-- ============ SKY: the agent ============ -->
    <Grid x:Name="Sky" Grid.Row="0" Background="{StaticResource SkyWorking}"
          Padding="20,44,20,22">
      <StackPanel Spacing="0">

        <!-- The orb. Breathes while the agent is busy; still when it is not. -->
        <Ellipse x:Name="Orb" Width="40" Height="40"
                 HorizontalAlignment="Left" Margin="0,0,0,14">
          <Ellipse.Fill>
            <RadialGradientBrush GradientOrigin="0.32,0.30" Center="0.32,0.30"
                                 RadiusX="0.85" RadiusY="0.85">
              <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
              <GradientStop Color="#8CFFFFFF" Offset="0.42"/>
              <GradientStop Color="#1FFFFFFF" Offset="1.0"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>

        <TextBlock x:Name="StateLabel" Text="WORKING"
                   Style="{StaticResource EyebrowText}" Foreground="White"/>

        <TextBlock x:Name="Headline"
                   Text="Looking for your September invoice"
                   Foreground="White" FontSize="21" FontWeight="SemiBold"
                   LineHeight="26" TextWrapping="Wrap" Margin="0,5,0,0"/>

        <TextBlock x:Name="SubLine" Text="Step 2 of 4 · about a minute left"
                   Foreground="White" Opacity="0.86" FontSize="13"
                   TextWrapping="Wrap" Margin="0,7,0,0"/>

        <ProgressBar x:Name="Progress" Value="56" Maximum="100"
                     Height="3" Margin="0,14,0,0"
                     Foreground="White" Background="#47FFFFFF"/>
      </StackPanel>

      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="AgentStates">
          <VisualState x:Name="Working"/>
          <VisualState x:Name="NeedsYou">
            <VisualState.Setters>
              <Setter Target="Sky.Background" Value="{StaticResource SkyNeedsYou}"/>
              <Setter Target="StateLabel.Text" Value="NEEDS YOU"/>
              <Setter Target="Headline.Text" Value="Cielo stopped to ask you something"/>
              <Setter Target="SubLine.Text" Value="Everything else is still moving"/>
              <Setter Target="Progress.Visibility" Value="Collapsed"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Clear">
            <VisualState.Setters>
              <Setter Target="Sky.Background" Value="{StaticResource SkyClear}"/>
              <Setter Target="StateLabel.Text" Value="ALL DONE"/>
              <Setter Target="Headline.Text" Value="Nothing needs you right now"/>
              <Setter Target="Progress.Visibility" Value="Collapsed"/>
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>

    <!-- ============ GROUND: your work ============ -->
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <ScrollViewer Grid.Row="0" Padding="14,16,14,0">
        <StackPanel Spacing="11">

          <!-- Shown only while an approval is outstanding. -->
          <Border Visibility="{x:Bind ViewModel.HasPendingRequestVisibility, Mode=OneWay}"
                  CornerRadius="16" Padding="14,13"
                  Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                  BorderThickness="1"
                  BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
            <StackPanel Spacing="6">
              <TextBlock Text="ASKING" Style="{StaticResource EyebrowText}"
                         Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
              <TextBlock Text="{x:Bind ViewModel.PendingQuestion, Mode=OneWay}"
                         FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{x:Bind ViewModel.PendingAddress, Mode=OneWay}"
                         FontFamily="Consolas" FontSize="13" Opacity="0.75"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <TextBlock Text="EARLIER TODAY" Style="{StaticResource EyebrowText}"
                     Opacity="0.6" Margin="3,4,0,0"/>

          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Work, Mode=OneWay}"
                         ItemTemplate="{StaticResource WorkCardTemplate}">
            <ItemsRepeater.Layout>
              <StackLayout Spacing="0"/>
            </ItemsRepeater.Layout>
          </ItemsRepeater>
        </StackPanel>
      </ScrollViewer>

      <!-- Composer: always reachable, never a separate destination. -->
      <Border Grid.Row="1" Margin="14,8,14,10" CornerRadius="22"
              Padding="15,9,9,9"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderThickness="1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" PlaceholderText="Ask Cielo to do something…"
                   BorderThickness="0" Background="Transparent"
                   AcceptsReturn="False" TextWrapping="NoWrap"/>
          <Button Grid.Column="1" Width="28" Height="28" CornerRadius="14"
                  Padding="0" Command="{x:Bind ViewModel.SendCommand}"
                  Background="{ThemeResource AccentFillColorDefaultBrush}">
            <FontIcon Glyph="&#xE74A;" FontSize="12" Foreground="White"/>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- ============ TABS ============ -->
    <!-- Uno.Toolkit's TabBar, because WinUI's NavigationView is desktop-shaped
         and does not give you a platform-correct bottom bar on a phone. -->
    <utu:TabBar Grid.Row="2" SelectedIndex="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
      <utu:TabBarItem Content="Home">
        <utu:TabBarItem.Icon><FontIcon Glyph="&#xE80F;"/></utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="Files">
        <utu:TabBarItem.Icon><FontIcon Glyph="&#xE8B7;"/></utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="Messages"
                      BadgeVisibility="{x:Bind ViewModel.UnreadVisibility, Mode=OneWay}">
        <utu:TabBarItem.Icon><FontIcon Glyph="&#xE8BD;"/></utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="Widgets">
        <utu:TabBarItem.Icon><FontIcon Glyph="&#xE80A;"/></utu:TabBarItem.Icon>
      </utu:TabBarItem>
    </utu:TabBar>
  </Grid>
</Page>
