# CieloOS runtime environment — provider-free defaults.
# install.sh writes the real file to /etc/cielo/cielo.env (filling UID + bind).

WORKSPACE_RUNTIME_ROOT=/opt/cielo
Runtime__SeedDemo=false
Database__Provider=sqlite

# Bind address. install.sh sets this per --mode:
#   app / kiosk (local only):  http://127.0.0.1:5148
#   headless (LAN / VPS):      http://0.0.0.0:5148
ASPNETCORE_URLS=http://127.0.0.1:5148

# Rootless podman (sessions) needs the service user's runtime dir.
# install.sh replaces UID_PLACEHOLDER with `id -u cielo`.
XDG_RUNTIME_DIR=/run/user/UID_PLACEHOLDER

# The chat UI the panel links to. install.sh appends this pointing at the Open
# WebUI service it installs (loopback:8080); set it yourself if you run your own
# client, or leave it unset and the panel simply shows no chat link.
# Chat__Url=http://localhost:8080/

# Provider-free by default: add a provider from the panel's Models tab (no
# restart), or set keys here and restart. Examples:
# Inference__Deepseek__ApiKey=sk-...
# Inference__Azure__ApiKey=...
# Inference__Azure__BaseUrl=https://<resource>.openai.azure.com/openai/v1
