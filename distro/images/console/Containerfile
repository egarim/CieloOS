# The Lun.Os console session image: a lightweight web terminal (ttyd) over a
# PERSISTENT, shared tmux session. The persistent session is what lets an agent
# observe and type into its console headlessly (via `podman exec tmux ...`)
# while a human can attach to the very same screen through ttyd.
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# One dropped connection should not discard a multi-gigabyte build.
#
# A clean-room install lost the whole desktop image to a single TLS hiccup:
#   curl: (56) OpenSSL SSL_read: ... unexpected eof while reading
# Neither apt nor curl retried, so several GB of completed work was thrown away
# because one mirror closed one socket. On a VPS with an ordinary consumer link
# that is not an unlucky day, it is a Tuesday. Set it once here rather than on
# every apt-get: this file is inherited by every image built FROM this one.
RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' \
      > /etc/apt/apt.conf.d/99cielo-retries

# Check-Date / Valid-Until are relaxed because trial VMs can boot with a skewed
# clock, which otherwise makes apt reject the archive metadata.
# Base shell tools + the "hands" for real work: an HTTP client (curl), JSON
# (jq), a text browser (w3m), and Python with openpyxl/requests so the agent can
# search the web (via the OS's SearXNG service) and build .csv/.xlsx files.
RUN apt-get -o Acquire::Check-Date=false -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        ttyd tmux bash ca-certificates procps nano less git \
        curl jq w3m python3 python3-pip python3-openpyxl python3-requests \
    && pip3 install --no-cache-dir --break-system-packages python-docx python-pptx \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /root
COPY entrypoint.sh /usr/local/bin/lunos-console-entrypoint
COPY websearch /usr/local/bin/websearch
RUN chmod +x /usr/local/bin/lunos-console-entrypoint /usr/local/bin/websearch

EXPOSE 7681
ENTRYPOINT ["/usr/local/bin/lunos-console-entrypoint"]
