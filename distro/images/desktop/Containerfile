# The Lun.Os desktop session image: the webtop XFCE desktop (Selkies on :3000)
# plus ONLYOFFICE Desktop Editors, which open and edit .xlsx / .pptx / .docx with
# high Microsoft-format fidelity — so a user (or an inhabiting human) can open the
# spreadsheets and documents the agent produces.
FROM lscr.io/linuxserver/webtop:ubuntu-xfce

# ONLYOFFICE ships a per-arch .deb. arm64 by default (our dev VM); for an x86
# build pass --build-arg ONLYOFFICE_DEB=<...onlyoffice-desktopeditors_amd64.deb>.
ARG ONLYOFFICE_DEB=https://download.onlyoffice.com/install/desktop/editors/linux/onlyoffice-desktopeditors_arm64.deb
ENV DEBIAN_FRONTEND=noninteractive

# Check-Date/Valid-Until are relaxed because trial VMs can have a skewed clock.
# xdotool + scrot are the agent's "hands and eyes" on the X11 desktop: the
# `desktop` surface drives xdotool (click/type/key) and captures with scrot.
# python3-gi + gir1.2-atspi-2.0 power AT-SPI-first grounding (the `lunos-atspi`
# reader) — exact element boxes from the accessibility tree, so the agent clicks
# element centers instead of guessed pixels.
RUN apt-get -o Acquire::Check-Date=false -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends curl ca-certificates xdotool scrot \
        python3-gi gir1.2-atspi-2.0 at-spi2-core \
    && curl -fsSL -o /tmp/onlyoffice.deb "$ONLYOFFICE_DEB" \
    && (dpkg -i /tmp/onlyoffice.deb || apt-get install -y -f --no-install-recommends) \
    && rm -f /tmp/onlyoffice.deb \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# The AT-SPI grounding reader + its session-D-Bus wrapper.
COPY atspi_gi.py /usr/local/lib/lunos/atspi_gi.py
COPY lunos-atspi /usr/local/bin/lunos-atspi
RUN chmod +x /usr/local/bin/lunos-atspi

# The `browser` surface's hands and eyes. Chromium is already in the webtop base
# (151 at the time of writing) and `websockets` is already in its python3, so this
# layer is one script: the helper drives the page over CDP on the container's own
# loopback, which is why the DevTools endpoint never has to be published to the
# host and one owner's browser stays out of another's reach.
COPY lunos-browser /usr/local/bin/lunos-browser
RUN chmod +x /usr/local/bin/lunos-browser

# The `recorder` surface: capture the session's desktop to an MP4 so the agent can
# turn the work it just did into a tutorial. The base image already ships the
# FFmpeg 8.x runtime libraries and libx264 (ONLYOFFICE pulls them in), so the CLI
# itself costs ~5 MB rather than a codec stack. x11grab comes with it, and
# x11-utils supplies xdpyinfo (the display geometry, which is NOT fixed — Selkies
# re-modes the display when a viewer connects) and xmessage for the on-screen
# recording marker.
RUN apt-get -o Acquire::Check-Date=false -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends ffmpeg x11-utils x11-xserver-utils \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY lunos-recorder /usr/local/bin/lunos-recorder
RUN chmod +x /usr/local/bin/lunos-recorder

# Runnable examples on the desktop. They live outside /config for the same reason
# the theme templates do: /config is the person's volume, and the seed script
# decides once what goes into it. Each example names the surfaces it exercises, so
# the catalogue is data — and the same files are how a fresh installation proves it
# can actually drive this machine.
# A desk you cannot type your own language on is broken, whatever the panel says.
# Locales must be GENERATED, not merely installed — without locale-gen the C.UTF-8
# fallback silently mangles anything outside ASCII, which is the failure people
# describe as "it looks fine until I type my own name". The keyboard layouts ship
# together so switching is a setting rather than an installation, and the fonts are
# here because Cyrillic renders as boxes without them and boxes look like a bug.
RUN apt-get -o Acquire::Check-Date=false -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        locales x11-xkb-utils xkb-data fonts-dejavu-core fonts-liberation2 \
    && sed -i 's/^# *\(en_US.UTF-8\|ru_RU.UTF-8\|es_ES.UTF-8\)/\1/' /etc/locale.gen \
    && locale-gen \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# The APPLICATIONS, not just our own interface.
#
# XFCE's parts ship their own translations and were already here — thunar, xfwm4,
# xfce4-panel, xfdesktop, mousepad, plank all had ru and es. What was missing is
# the TOOLKIT: no gtk30.mo, no glib20.mo, which means every file-open dialog, every
# Cancel button and every GLib error stays English while the menus around them are
# not. Menus in one language and dialogs in another is the half-translated look
# that reads as a broken build rather than a missing package.
#
# Ubuntu keeps those in language packs, installed to /usr/share/locale-langpack.
# Verified after installing: 419 Russian catalogues instead of 41, and GTK's Cancel
# resolves to "_Отмена". Costs about 40 MB for both languages.
#
# ONLYOFFICE needs nothing here: it is CEF-based and already ships ru.pak, es.pak
# and es-419.pak, so it follows the session's locale.
RUN apt-get -o Acquire::Check-Date=false -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        language-pack-ru language-pack-gnome-ru \
        language-pack-es language-pack-gnome-es \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Three layouts, always present, switched with both Shift keys together. A person
# whose language is not the desk's default should not have to install anything to
# write in it — and the agent's own typing is unaffected, because xdotool types
# keysyms rather than going through the layout.
COPY cielo-keyboard-seed /custom-cont-init.d/97-cielo-keyboard
RUN chmod +x /custom-cont-init.d/97-cielo-keyboard

COPY examples/ /opt/cielo-examples/
COPY cielo-examples-seed /custom-cont-init.d/98-cielo-examples
RUN chmod +x /custom-cont-init.d/98-cielo-examples

# The CieloOS look: light, macOS-adjacent, and all from Ubuntu universe, so it
# builds identically on both architectures with nothing fetched from GitHub.
# Exact names matter and are easy to get wrong — the light variants are
# Orchis-Light, Papirus-Light and Breeze_Light (NOT Breeze_Snow).
RUN apt-get -o Acquire::Check-Date=false -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        orchis-gtk-theme papirus-icon-theme breeze-cursor-theme fonts-inter plank dconf-cli \
    && apt-get install -y --no-install-recommends librsvg2-bin \
    && install -d /usr/share/backgrounds/cielo \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# The wallpaper ships as vector and is rasterised here, so git carries 2 KB
# instead of a multi-megabyte gradient. librsvg goes away again afterwards.
COPY theme/cielo-light.svg /usr/share/backgrounds/cielo/cielo-light.svg
RUN rsvg-convert -w 2560 -h 1440 -o /usr/share/backgrounds/cielo/cielo-light.png \
        /usr/share/backgrounds/cielo/cielo-light.svg \
    && apt-get purge -y librsvg2-bin && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Templates live outside /config on purpose: /config is the session's persistent
# volume, so anything written there would become the user's own copy. The
# init script seeds from here once, then leaves the session alone.
COPY theme/xfce/ /opt/cielo-theme/xfce/
COPY theme/autostart/ /opt/cielo-theme/autostart/
COPY theme/plank/ /opt/cielo-theme/plank/
COPY theme/gtk-3.0/ /opt/cielo-theme/gtk-3.0/

# Plank reads dconf, so the dock theme has to be a dconf default rather than a
# file in the person.s config. Compiling it into the system database leaves
# their own settings free to override it.
COPY theme/dconf/user-profile /etc/dconf/profile/user
COPY theme/dconf/00-cielo-dock /etc/dconf/db/local.d/00-cielo-dock
RUN dconf update
# Plank's shipped themes are all dark, and orchis-gtk-theme does not install one,
# so the light dock is ours. It lives with Plank's own themes, not in /config,
# because it is part of the image rather than the person's settings.
COPY theme/plank/themes/CieloOS/ /usr/share/plank/themes/CieloOS/
COPY theme/cielo-wallpaper /usr/local/bin/cielo-wallpaper
COPY theme/cielo-theme-seed /custom-cont-init.d/99-cielo-theme
RUN chmod +x /usr/local/bin/cielo-wallpaper /custom-cont-init.d/99-cielo-theme
