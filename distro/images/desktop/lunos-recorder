#!/usr/bin/env python3
"""Record the session's desktop to an MP4, for tutorials the agent narrates later.

Invoked by the runtime as:
    podman exec -u abc -e DISPLAY=:1 <container> lunos-recorder <verb> [args...]

Verbs: start [seconds] [name] | stop | status

Two things here are not incidental.

TRUNCATION IS SILENT. Selkies resizes the shared X display via RandR whenever a
viewer connects or changes size, and an in-flight x11grab does not survive the
reconfiguration: it dies on XShmGetImage BadMatch, stops early, and STILL EXITS
ZERO. Measured on this hardware: 3.97s written of a requested 12s, exit 0. So the
recorder never trusts ffmpeg's exit code — it compares the encoded duration
against wall-clock elapsed and reports a short file as a failure, with the reason.
A tutorial built from footage that quietly stops half way is worse than no
tutorial, because nobody checks.

THE RECORDING LIGHT IS PART OF THE FEATURE. A person can take a seat at a session
that is already recording (that is what `session.inhabit` is for). They must be
able to see it without being told, so `start` puts a marker on the desktop and
`stop` removes it. If the marker cannot be drawn, the recording still runs — a
failed indicator must not deny the capability — but the state file records that it
was missing, and the runtime reports it.
"""
import contextlib
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import time

HOME = os.environ.get("HOME", "/config")
STATE = os.path.join(HOME, ".cielo-recorder.json")
LOCK = os.path.join(HOME, ".cielo-recorder.lock")
OUTPUT_DIR = os.path.join(HOME, "recordings")
DISPLAY = os.environ.get("DISPLAY", ":1")

# A hard ceiling, not a suggestion: ffmpeg is given -t, so a runtime that dies
# without calling stop cannot leave a process filling the home volume forever.
MAX_SECONDS = 1800
DEFAULT_SECONDS = 300
FPS = 30

# How much shorter than wall-clock an encode may be before it is called truncated.
# Encoders trail the clock slightly at shutdown; a RandR abort loses whole seconds.
TOLERANCE_SECONDS = 1.5

NAME_OK = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


def emit(payload, code=0):
    print(json.dumps(payload))
    sys.exit(code)


def fail(detail, **extra):
    emit({"ok": False, "detail": str(detail), **extra}, code=1)


def run(argv, timeout=20):
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout)


def geometry():
    """The display's CURRENT size. Never assume: three live sessions on this box
    had three different geometries, and one had drifted through six modes."""
    try:
        out = run(["xdpyinfo", "-display", DISPLAY]).stdout
        found = re.search(r"dimensions:\s+(\d+)x(\d+)", out)
        if found:
            width, height = int(found.group(1)), int(found.group(2))
            # x264 needs even dimensions; an odd-sized display is not a reason to
            # refuse to record.
            return width - (width % 2), height - (height % 2)
    except (OSError, subprocess.SubprocessError):
        pass
    return None


@contextlib.contextmanager
def exclusive():
    """One recorder command at a time, per session.

    The state file alone is not enough: two `start` requests can both read "not
    recording" before either writes, and then BOTH launch ffmpeg. The second write
    hides the first PID, so `stop` kills one capture and the other keeps running,
    invisible, until its own time limit — filling the owner's home with footage
    nobody asked for and nobody can stop.
    """
    handle = os.open(LOCK, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            fail("Another recorder command is already running on this session.")
        yield
    finally:
        with contextlib.suppress(OSError):
            fcntl.flock(handle, fcntl.LOCK_UN)
        os.close(handle)


def claim(directory, base):
    """Take a filename nobody else holds, atomically.

    Two recordings started in the same second derive the same name, and ffmpeg's
    -y would overwrite the first one that already finished. O_EXCL makes the claim
    the filesystem's decision rather than a check-then-write race.
    """
    for suffix in [""] + [f"-{n}" for n in range(2, 100)]:
        path = os.path.join(directory, f"{base}{suffix}.mp4")
        try:
            os.close(os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644))
            return path
        except FileExistsError:
            continue
        except OSError:
            return None
    return None


def read_state():
    try:
        with open(STATE, encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


def identity_of(pid):
    """(start time in clock ticks, command name) for a pid, or None.

    A pid on its own is not an identity. This recorder's state file OUTLIVES its
    ffmpeg — the process stops itself at -t while the file waits for `stop` — and
    Linux reuses pids, so `stop` could send SIGINT and then SIGKILL to whatever
    innocent process happened to inherit the number. The kernel's start time makes
    the pid unambiguous: it cannot be shared by two processes with the same id.
    """
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as handle:
            data = handle.read()
    except (OSError, TypeError, ValueError):
        return None
    # comm sits in parentheses and may itself contain spaces or parentheses, so
    # the only safe split is on the LAST ')'.
    opened, closed = data.find("("), data.rfind(")")
    if opened < 0 or closed < opened:
        return None
    fields = data[closed + 1:].split()
    try:
        # starttime is field 22 overall; the first two fields are pid and comm.
        return int(fields[19]), data[opened + 1:closed]
    except (IndexError, ValueError):
        return None


def still_running(state):
    """Is the process this state file describes STILL the one it described?"""
    if not state:
        return False
    identity = identity_of(state.get("pid"))
    if identity is None:
        return False
    started, command = identity
    return started == state.get("pidStart") and command == state.get("pidComm")


def duration_of(path):
    try:
        out = run([
            "ffprobe", "-v", "error", "-show_entries", "format=duration",
            "-of", "default=nw=1:nk=1", path,
        ]).stdout.strip()
        return float(out)
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def indicator(on, seconds=MAX_SECONDS):
    """A visible recording marker on the desktop.

    Best effort in that a failure must not deny the recording — but the ANSWER
    must be true, because the caller reports "no marker" as a privacy warning and
    a false yes is worse than no marker at all. (It was a false yes: the check was
    an always-true expression, so a marker that never reached the display still
    claimed success.)

    The timeout is the recording's own length, not the ceiling: ffmpeg stops
    itself at -t, and a marker pinned to the maximum would sit on the desktop
    announcing a recording that ended half an hour ago.
    """
    if not on:
        try:
            run(["pkill", "-f", "xmessage.*RECORDING"], timeout=5)
            return True
        except (OSError, subprocess.SubprocessError):
            return False

    try:
        marker = subprocess.Popen(
            ["xmessage", "-display", DISPLAY, "-geometry", "+20+20",
             "-bg", "#b00020", "-fg", "white", "-timeout", str(int(seconds)),
             " ●  RECORDING — this desktop is being captured "],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True)
    except (OSError, subprocess.SubprocessError):
        return False

    # xmessage exits immediately if it cannot reach the display, so the only
    # honest check is whether it is still alive a moment later.
    time.sleep(0.4)
    return marker.poll() is None


def start(argv):
    existing = read_state()
    if still_running(existing):
        return emit({"ok": False, "detail": "A recording is already running on this session.",
                     "recording": describe(existing)}, code=1)

    seconds = DEFAULT_SECONDS
    if argv and argv[0].isdigit():
        seconds = max(1, min(MAX_SECONDS, int(argv[0])))
        argv = argv[1:]
    name = argv[0] if argv else "session"
    if not NAME_OK.match(name):
        return fail(f"'{name}' is not a usable recording name.")

    size = geometry()
    if size is None:
        return fail(f"Could not read the geometry of display {DISPLAY}.")
    width, height = size

    os.makedirs(OUTPUT_DIR, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S", time.gmtime())
    path = claim(OUTPUT_DIR, f"{name}-{stamp}")
    if path is None:
        return fail(f"Could not create a recording file in {OUTPUT_DIR}.")

    marked = indicator(True, seconds)

    started = time.time()
    process = subprocess.Popen(
        [
            "ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-y",
            "-f", "x11grab", "-draw_mouse", "1",
            "-framerate", str(FPS), "-video_size", f"{width}x{height}",
            "-i", DISPLAY,
            "-t", str(seconds),
            "-c:v", "libx264", "-preset", "veryfast", "-crf", "23",
            "-pix_fmt", "yuv420p", "-movflags", "+faststart",
            path,
        ],
        stdout=subprocess.DEVNULL,
        stderr=open(path + ".log", "wb"),
        start_new_session=True,
    )

    # Give it a beat to fail loudly (a bad display, a full disk) rather than
    # reporting a recording that died a tenth of a second later. Never outwait the
    # recording itself: a 1-second capture FINISHES inside a 1-second probe, and
    # treating that as an immediate failure made the shortest supported length the
    # least reliable one.
    time.sleep(min(1.0, max(0.2, seconds / 2)))
    if process.poll() is not None:
        # Exited already — which means either it failed, or it is simply done.
        # "Done" is a real outcome for a short recording, and the file is the
        # witness: a playable one is a finished capture, not a broken start.
        encoded = duration_of(path)
        if process.returncode != 0 or not encoded:
            indicator(False)
            detail = ""
            try:
                with open(path + ".log", encoding="utf-8", errors="replace") as handle:
                    detail = handle.read().strip()[:400]
            except OSError:
                pass
            return fail(f"ffmpeg exited immediately: {detail or 'no output'}")

    state = {
        "id": os.path.splitext(os.path.basename(path))[0],
        "path": path,
        "pid": process.pid,
        "pidStart": (identity_of(process.pid) or (0, ""))[0],
        "pidComm": (identity_of(process.pid) or (0, ""))[1],
        "startedAtUnix": started,
        "startedAtIso": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(started)),
        "requestedSeconds": seconds,
        "width": width,
        "height": height,
        "fps": FPS,
        "display": DISPLAY,
        "indicator": bool(marked),
    }
    with open(STATE, "w", encoding="utf-8") as handle:
        json.dump(state, handle)

    return emit({"ok": True, "detail": f"Recording {width}x{height} at {FPS}fps for up to {seconds}s.",
                 "recording": describe(state)})


def describe(state, extra=None):
    out = {
        "id": state.get("id"),
        "path": state.get("path"),
        "startedAt": state.get("startedAtIso"),
        "startedAtUnix": state.get("startedAtUnix"),
        "requestedSeconds": state.get("requestedSeconds"),
        "width": state.get("width"),
        "height": state.get("height"),
        "fps": state.get("fps"),
        "indicator": state.get("indicator", False),
    }
    if extra:
        out.update(extra)
    return out


def stop(_argv):
    state = read_state()
    if state is None:
        return fail("No recording has been started on this session.")

    pid = state.get("pid")
    elapsed = time.time() - float(state.get("startedAtUnix", time.time()))
    if still_running(state):
        # SIGINT, not SIGKILL: ffmpeg must write the moov atom or the file is
        # unplayable, which would turn every stop into a lost recording.
        try:
            os.kill(pid, signal.SIGINT)
        except OSError:
            pass
        deadline = time.monotonic() + 15
        while still_running(state) and time.monotonic() < deadline:
            time.sleep(0.2)
        if still_running(state):
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass

    indicator(False)
    try:
        os.remove(STATE)
    except OSError:
        pass

    path = state.get("path", "")
    size = os.path.getsize(path) if os.path.exists(path) else 0
    encoded = duration_of(path)
    log = ""
    try:
        with open(path + ".log", encoding="utf-8", errors="replace") as handle:
            log = handle.read().strip()[:400]
    except OSError:
        pass

    if size == 0 or encoded is None:
        return emit({"ok": False, "detail": f"The recording produced no playable video. {log}".strip(),
                     "recording": describe(state, {"bytes": size})}, code=1)

    # The whole point: ffmpeg exits 0 after a RandR abort, so the duration is the
    # only honest witness. `expected` is capped by the requested length because a
    # recording that hit its own -t limit is complete, not short.
    expected = min(elapsed, float(state.get("requestedSeconds", elapsed)))
    truncated = encoded + TOLERANCE_SECONDS < expected
    result = describe(state, {
        "bytes": size,
        "seconds": round(encoded, 2),
        "expectedSeconds": round(expected, 2),
        "truncated": truncated,
    })
    if truncated:
        return emit({
            "ok": False,
            "detail": (f"The recording stopped early: {encoded:.1f}s of {expected:.1f}s. "
                       "The X display was almost certainly resized while recording — "
                       "connecting or resizing a viewer does that. " + log).strip(),
            "recording": result,
        }, code=1)

    # The ffmpeg log is evidence when something went wrong and litter when it did
    # not. On success it is empty and would sit in the owner's home next to every
    # recording forever, so it goes; on failure it is kept and quoted above.
    try:
        os.remove(path + ".log")
    except OSError:
        pass

    return emit({"ok": True, "detail": f"Recorded {encoded:.1f}s to {path}.", "recording": result})


def status(_argv):
    state = read_state()
    if state is None:
        return emit({"ok": True, "recording": None, "detail": "Not recording."})
    running = still_running(state)
    path = state.get("path", "")
    return emit({"ok": True, "running": running,
                 "recording": describe(state, {
                     "bytes": os.path.getsize(path) if os.path.exists(path) else 0,
                     "elapsedSeconds": round(time.time() - float(state.get("startedAtUnix", time.time())), 1),
                 }),
                 "detail": "Recording." if running else "The recording has finished; call stop to close it out."})


def main():
    verbs = {"start": start, "stop": stop, "status": status}
    if len(sys.argv) < 2 or sys.argv[1] not in verbs:
        fail("usage: lunos-recorder <start [seconds] [name] | stop | status>")
    try:
        if sys.argv[1] == "status":
            verbs["status"](sys.argv[2:])
        else:
            # start and stop both read-then-write the state file; the lock is what
            # stops two of them interleaving into an untracked second recording.
            with exclusive():
                verbs[sys.argv[1]](sys.argv[2:])
    except SystemExit:
        raise
    except Exception as error:
        fail(f"{type(error).__name__}: {error}")


if __name__ == "__main__":
    main()
