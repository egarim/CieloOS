{
  "schema": 1,
  "toolName": "powershell.run",
  "displayName": "PowerShell",
  "executor": "sandboxed-process",
  "command": {
    "executable": "pwsh",
    "argsTemplate": ["-NoLogo", "-NoProfile", "-NonInteractive", "-File", "{script}"]
  },
  "arguments": {
    "script": { "type": "path", "required": true, "scope": "workspace" }
  },
  "policy": {
    "defaultDecision": "RequireApproval",
    "requiresApprovalWhen": ["always"],
    "denyWhen": ["unsigned-script-outside-workspace"]
  }
}
