[Unit]
Description=Agent Policy Service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/workspace-runtime
Environment=ASPNETCORE_URLS=http://0.0.0.0:5148
Environment=WORKSPACE_RUNTIME_ROOT=/opt/workspace-runtime
Environment=Database__SqlitePath=/var/lib/workspace-runtime/workspace-runtime.db
Environment=Auth__SecretsPath=/var/lib/workspace-runtime/secrets
StateDirectory=workspace-runtime
ExecStart=/opt/workspace-runtime/bin/workspace-runtime-api
# Share the agent token with the workspace user's group so workspace-agent can
# authenticate without root; the human token stays root-only (read via sudo).
ExecStartPost=/bin/sh -c 'for i in $(seq 1 30); do if [ -f /var/lib/workspace-runtime/secrets/agent.token ]; then chgrp workspace /var/lib/workspace-runtime/secrets/agent.token && chmod 640 /var/lib/workspace-runtime/secrets/agent.token && exit 0; fi; sleep 1; done; exit 1'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
